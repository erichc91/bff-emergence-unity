// BFFSim.compute — GPU BFF virtual machine
//
// Instruction set (paper: Agüera y Arcas et al. arXiv:2406.19108)
//   <  (60)  head0 left      >  (62)  head0 right
//   {  (123) head1 left      }  (125) head1 right
//   +  (43)  increment       -  (45)  decrement
//   .  (46)  copy head0→head1   (REPLICATION when head1 >= tapeSize)
//   ,  (44)  copy head1→head0
//   [  (91)  jump forward if head0==0
//   ]  (93)  jump back    if head0!=0
//
// Tape size is fully runtime-driven from the tapeSize uniform.
// Change BFFSettings.tapeSize in the Inspector — no shader edits needed.
// Maximum supported: tapeSize=128 (combined=256). Must be power of 2.

#pragma kernel StepEpoch
#pragma kernel UpdateColourMap

// Local arrays fixed at max size so HLSL can allocate at compile time.
// Loop bounds use the runtime tapeSize uniform, so unused slots are never touched.
#define MAX_TAPE     128
#define MAX_COMBINED 256

// ── Shared buffers ────────────────────────────────────────────────────────────

RWStructuredBuffer<uint> TapeData;
RWTexture2D<float4>      DisplayTexture;

int   width;
int   height;
int   tapeSize;          // cells bytes; combined = tapeSize*2; max 128
int   instructionLimit;
int   displayMode;       // 0 = instruction categories  1 = species identity
float mutationRate;
float time;

// ── Hash RNG — identical to Lague's slime sim ─────────────────────────────────

uint hash(uint state)
{
    state ^= 2747636419u;
    state *= 2654435769u;
    state ^= state >> 16;
    state *= 2654435769u;
    state ^= state >> 16;
    state *= 2654435769u;
    return state;
}

float randFloat(uint h) { return (float)h / 4294967295.0; }

// ── StepEpoch ─────────────────────────────────────────────────────────────────

[numthreads(8, 8, 1)]
void StepEpoch(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= width || (int)id.y >= height) return;

    int combined = tapeSize * 2;
    int mask     = combined - 1;

    uint rng = hash((uint)(id.y * width + id.x) + (uint)(time * 7919.0));

    // Pick a random cardinal neighbour (wrapping)
    uint dir = hash(rng) & 3u;
    int nx = (int)id.x, ny = (int)id.y;
    if      (dir == 0u) nx = (nx + 1) % width;
    else if (dir == 1u) nx = (nx - 1 + width) % width;
    else if (dir == 2u) ny = (ny + 1) % height;
    else                ny = (ny - 1 + height) % height;

    int a_base = ((int)id.y * width + (int)id.x) * tapeSize;
    int b_base = (ny * width + nx)                * tapeSize;

    // ── Load combined tape: [B template | A target] ───────────────────────────
    uint buf[MAX_COMBINED];
    for (int i = 0; i < tapeSize; i++)
    {
        buf[i]           = TapeData[b_base + i];
        buf[i + tapeSize] = TapeData[a_base + i];
    }

    // ── Pre-compute jump table — all uint to avoid signed % warnings ──────────
    int jumps[MAX_COMBINED];
    for (int j = 0; j < combined; j++) jumps[j] = -1;

    for (int pos = 0; pos < combined; pos++)
    {
        if (buf[pos] == 91u)   // [
        {
            int depth = 1, scan = pos + 1, scanned = 0;
            while (depth > 0 && scanned < combined)
            {
                uint b2 = buf[scan & mask];
                if (b2 == 91u) depth++;
                if (b2 == 93u) depth--;
                scan++; scanned++;
            }
            if (depth == 0) jumps[pos] = (scan - 1) & mask;
        }
        else if (buf[pos] == 93u)  // ]
        {
            int depth = 1, scanned = 0;
            int scan = ((pos - 1) % combined + combined) % combined;
            while (depth > 0 && scanned < combined)
            {
                uint b2 = buf[scan & mask];
                if (b2 == 93u) depth++;
                if (b2 == 91u) depth--;
                scan = ((scan - 1) % combined + combined) % combined;
                scanned++;
            }
            if (depth == 0) jumps[pos] = (scan + 1) & mask;
        }
    }

    // ── Execute BFF VM ────────────────────────────────────────────────────────
    int head0 = 0, head1 = 0, ip = 0;

    for (int cycle = 0; cycle < instructionLimit; cycle++)
    {
        int  cur   = ip & mask;
        uint instr = buf[cur];

        if      (instr == 60u)  head0 = ((head0 - 1) % combined + combined) & mask;  // <
        else if (instr == 62u)  head0 = (head0 + 1) & mask;                           // >
        else if (instr == 123u) head1 = ((head1 - 1) % combined + combined) & mask;  // {
        else if (instr == 125u) head1 = (head1 + 1) & mask;                           // }
        else if (instr == 43u)  buf[head0 & mask] = (buf[head0 & mask] + 1u)   & 255u; // +
        else if (instr == 45u)  buf[head0 & mask] = (buf[head0 & mask] + 255u) & 255u; // -
        else if (instr == 46u)  buf[head1 & mask] = buf[head0 & mask];                 // .
        else if (instr == 44u)  buf[head0 & mask] = buf[head1 & mask];                 // ,
        else if (instr == 91u)  // [
        {
            if (buf[head0 & mask] == 0u)
            {
                if (jumps[cur] >= 0) ip = jumps[cur];
                else break;
            }
        }
        else if (instr == 93u)  // ]
        {
            if (buf[head0 & mask] != 0u)
            {
                if (jumps[cur] >= 0) ip = jumps[cur];
                else break;
            }
        }

        ip++;
    }

    // ── Mutate and write back A's (target) portion only ───────────────────────
    rng = hash(rng + 99991u);
    for (int w = 0; w < tapeSize; w++)
    {
        uint val = buf[w + tapeSize];
        if (randFloat(hash(rng + (uint)w)) < mutationRate)
            val = hash(rng + (uint)w + 13u) & 255u;
        TapeData[a_base + w] = val;
    }
}

// ── Colour helpers ────────────────────────────────────────────────────────────

uint byteCategory(uint b)
{
    if (b == 0u)                    return 0u;
    if (b == 60u  || b == 62u)     return 1u;  // < >
    if (b == 123u || b == 125u)    return 2u;  // { }
    if (b == 43u  || b == 45u)     return 3u;  // + -
    if (b == 46u  || b == 44u)     return 4u;  // . ,
    if (b == 91u  || b == 93u)     return 5u;  // [ ]
    return 6u;
}

static const float categoryHue[7] = { 0.0, 0.58, 0.72, 0.33, 0.12, 0.02, 0.0 };

float3 HSVtoRGB(float h, float s, float v)
{
    float4 K = float4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
    float3 p = abs(frac(h.xxx + K.xyz) * 6.0 - K.www);
    return v * lerp(K.xxx, saturate(p - K.xxx), s);
}

// ── UpdateColourMap ───────────────────────────────────────────────────────────
//
// MODE 0 — Instruction category view:
//   Hue = dominant instruction type, Saturation = instruction density
//
// MODE 1 — Species identity view:
//   FNV-1a hash of full tape → unique hue per program.
//   Exact copies (BFF replication is byte-exact) share the same hue.
//   Mutation shifts hue gradually — colour drift = evolutionary distance.

[numthreads(8, 8, 1)]
void UpdateColourMap(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= width || (int)id.y >= height) return;

    int base_idx = ((int)id.y * width + (int)id.x) * tapeSize;

    uint counts[7] = { 0u, 0u, 0u, 0u, 0u, 0u, 0u };
    for (int i = 0; i < tapeSize; i++)
        counts[byteCategory(TapeData[base_idx + i])]++;

    uint  activeInstr = counts[1] + counts[2] + counts[3] + counts[4] + counts[5];
    float saturation  = saturate((float)activeInstr / (float)tapeSize * 4.0);

    if (activeInstr == 0u)
    {
        DisplayTexture[id.xy] = float4(0.04, 0.05, 0.08, 1.0);
        return;
    }

    float hue;

    if (displayMode == 1)
    {
        uint fingerprint = 2166136261u;
        for (int t = 0; t < tapeSize; t++)
            fingerprint = (fingerprint ^ TapeData[base_idx + t]) * 16777619u;
        fingerprint = hash(fingerprint);
        hue = frac((float)fingerprint / 4294967295.0);
    }
    else
    {
        uint dom = 1u;
        for (uint c = 2u; c <= 5u; c++)
            if (counts[c] > counts[dom]) dom = c;
        hue = categoryHue[dom];
    }

    float val = lerp(0.35, 1.0, saturation);
    DisplayTexture[id.xy] = float4(HSVtoRGB(hue, saturation, val), 1.0);
}
